flux_grad <- read_csv('../../data_directory/sediment_trap_data.csv')%>%
mutate(carbonChl_ratio = fluxC / fluxChl)%>%
filter(iceObs != 'ow')
flux_grad_wcOnly <- filter(flux_grad, depth >= 8)
ggplot(flux_grad,
aes(
x = paste(iceObs, depthCat),
y = carbonChl_ratio,
color = depthCat

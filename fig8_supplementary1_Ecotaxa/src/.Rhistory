'Water Column' = 'ctd',
'Upper Trap' = 'shallow_trap',
'Deep Trap' = 'deep_trap') %>%
fct_relevel("Ice Core", "Ice-tethered Trap", "Water Column",
"Upper Trap", "Deep Trap"))
